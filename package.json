{
  "name": "docs-boilerplate",
  "version": "0.1.0",
  "private": true,
  "description": "Documentation site boilerplate built on Next.js and Fumadocs, with an animated accordion sidebar, MDX content and built-in search.",
  "keywords": [
    "boilerplate",
    "bun",
    "docs",
    "documentation",
    "fumadocs",
    "mdx",
    "nextjs",
    "starter",
    "tailwindcss",
    "template"
  ],
  "homepage": "https://github.com/remcostoeten/docs-boilerplate#readme",
  "bugs": {
    "url": "https://github.com/remcostoeten/docs-boilerplate/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Remco Stoeten",
    "url": "https://remcostoeten.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/remcostoeten/docs-boilerplate.git"
  },
  "type": "module",
  "scripts": {
    "dev": "bun scripts/serve.ts dev",
    "build": "bun --bun next build",
    "start": "bun scripts/serve.ts start",
    "postinstall": "fumadocs-mdx",
    "typecheck": "fumadocs-mdx && tsc --noEmit",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "check": "vp check"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "fumadocs-core": "^16.17.5",
    "fumadocs-mdx": "^15.4.7",
    "fumadocs-ui": "^16.17.5",
    "lucide-react": "^1.59.0",
    "motion": "^14.3.0",
    "next": "^16.4.2",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6",
    "vite-plus": "^1.3.0"
  },
  "engines": {
    "bun": ">=1.3"
  }
}
